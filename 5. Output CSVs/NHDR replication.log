PASS  Step 17 WDI GNI PPP 2018-19 fiscal average against NHDR's control, percent [published 4922]  computed       0.0610  target       0.0000  tol  0.1000

. tempfile hdim

. local first = 1

. foreach spec in "2018_19|$pd17/PKBR71DT/PKBR71FL.DTA|stacked|weights|edu1819|`=gnify_2018_19'" ///
>     "2006_07|$pd06/PKBR53DT/PKBR53FL.DTA|stacked05|weight|edu0506|`=gnify_2006_07'" {
  2.     tokenize "`spec'", parse("|")
  3.     local yr `1'
  4.     local pdf `3'
  5.     local st `5'
  6.     local wv `7'
  7.     local ed `9'
  8.     local pcipub `11'
  9.     * Health
.     nhdr_pdhs_le_domains using "`pdf'"
 10.     tempfile le_`yr'
 11.     save `le_`yr''
 12.     * Income
.     use ``st'', clear
 13.     collapse (mean) cons=pc_exp [aw=`wv'], by(domain)
 14.     gen str3 quintile = "All"
 15.     tempfile in_`yr'
 16.     save `in_`yr''
 17.     use ``st'', clear
 18.     drop if missing(q)
 19.     collapse (mean) cons=pc_exp [aw=`wv'], by(domain q)
 20.     gen str3 quintile = "Q" + string(q)
 21.     drop q
 22.     append using `in_`yr''
 23.     quietly summarize cons if domain == "Pakistan" & quintile == "All"
 24.     gen double pci_micro = cons * `pcipub' / r(mean)
 25.     * Education, and the published inputs of the same year
.     merge 1:1 domain quintile using ``ed'', keepusing(lit_reproduced ner_reproduced) nogenerate
 26.     merge 1:1 domain quintile using `le_`yr'', keep(master match) nogenerate
 27.     merge 1:1 domain quintile using `t2a', keepusing(lit_`yr' ner_`yr' le_`yr' pci_`yr') ///
>         keep(master match) nogenerate
 28.     rename (lit_`yr' ner_`yr' le_`yr' pci_`yr') (lit_pub ner_pub le_pub pci_pub)
 29.     nhdr_index, literacy(lit_pub) enrolment(ner_pub) life(le_pub) income(pci_pub) prefix(p_)
 30.     nhdr_index, literacy(lit_reproduced) enrolment(ner_reproduced) life(le_pub) income(pci_pub) prefix(e_)
 31.     nhdr_index, literacy(lit_reproduced) enrolment(ner_reproduced) life(le_pdhs) income(pci_pub) prefix(eh_)
 32.     nhdr_index, literacy(lit_reproduced) enrolment(ner_reproduced) life(le_pdhs) income(pci_micro) prefix(m_)
 33.     gen str7 year = subinstr("`yr'", "_", "-", .)
 34.     if `first' == 0 append using `hdim'
 35.     save `hdim', replace
 36.     local first = 0
 37. }
