. * ---- 23.2 Household indicators from the HIES, one program for three rounds ---------------
. * In memory: one record per person with hhid, age, prov, weight, cls (class
. * attended now, missing if not attending), t_exp (annual household
. * consumption) and ee (annual household education spending). Replaces the
. * data with five rows, Pakistan and the provinces.
. capture program drop nhdr_cdi_hh

. program define nhdr_cdi_hh
  1.     syntax , DEFLator(real)
  2.     bysort hhid: gen int _nh = _N
  3.     gen double pce = t_exp / _nh
  4.     * Quintiles of persons on consumption per head, national cut.
.     gen byte _ok = !missing(pce, weight)
  5.     gen double _w0 = cond(_ok, weight, 0)
  6.     sort pce hhid idc
  7.     gen double _cum = sum(_w0)
  8.     egen double _tot = total(_w0)
  9.     gen byte Q = ceil(5 * _cum / _tot) if _ok
 10.     replace Q = 1 if Q < 1 & _ok
 11.     replace Q = 5 if Q > 5 & _ok & !missing(Q)
 12.     gen double top2  = (Q >= 4) if age < 18 & !missing(Q)
 13.     gen double ner_p = inrange(cls, 1, 5)  if inrange(age, 5, 9)
 14.     gen double ner_m = inrange(cls, 6, 8)  if inrange(age, 10, 12)
 15.     gen double ner_x = inrange(cls, 9, 10) if inrange(age, 13, 14)
 16.     gen byte _ch = (age < 18)
 17.     bysort hhid: egen double _nc = total(_ch)
 18.     gen double NE = 2 + 1.4 * (_nh - _nc - 1) + _nc
 19.     by hhid: gen byte _first = (_n == 1)
 20.     gen double income_pce = t_exp / 12 / NE / `deflator' if _first
 21.     gen double eec        = ee / 12 / NE / `deflator'    if _first
 22.     nhdr_by_province, vars(income_pce eec top2 ner_p ner_m ner_x) wgt(weight) province(prov)
 23.     foreach v in top2 ner_p ner_m ner_x {
 24.         replace `v' = 100 * `v'
 25.     }
 26. end

. 
