. * ---- 14.4 Design-based standard errors -------------------------------------------------
. foreach v in lit15 ner {
  2.     use `p19p', clear
  3.     keep if !missing(`v')
  4.     gen double _z = `v' * weights
  5.     * Cluster totals: z_c and w_c.
.     collapse (sum) _z _w=weights, by(province district psu)
  6.     bysort province district: gen int clusters = _N
  7.     by province district: egen double _W = total(_w)
  8.     by province district: egen double _Z = total(_z)
  9.     gen double _dev2 = (_z - (_Z / _W) * _w)^2
 10.     collapse (sum) _dev2 (first) clusters _W, by(province district)
 11.     gen double `v'_se_pp = 100 * sqrt((clusters / (clusters - 1)) * _dev2 / _W^2) ///
>         if clusters >= 2 & _W > 0
 12.     rename clusters `v'_clusters
 13.     keep province district `v'_se_pp `v'_clusters
 14.     tempfile se_`v'
 15.     save `se_`v''
 16. }
