. 
. * ---- 8A.3 Stunting and wasting -------------------------------------------------
. * De facto children under five (hv103 = 1, hc1 under 60 months) with a valid
. * z-score (hc70 and hc72 below 9990, which excludes the flagged and missing
. * codes 9996 to 9999). Stunted: hc70 below -200. Wasted: hc72 below -200.
. * PDHS 2006-07 did not measure children, which 8A.3 tests on the file itself.
. * In that case the 2007-08 CDI keeps NHDR's printed anthropometry, and the
. * PDHS 2012-13 values are shown beside it.
. tempfile pdanth

. local first = 1

. foreach spec in "2006_07|$pd06/PKPR53DT/PKPR53FL.DTA" "2012_13|$pd12/PKPR61DT/PKPR61FL.DTA" ///
>     "2017_18|$pd17/PKPR71DT/PKPR71FL.DTA" {
  2.     local rd = substr("`spec'", 1, strpos("`spec'", "|") - 1)
  3.     local fl = substr("`spec'", strpos("`spec'", "|") + 1, .)
  4.     quietly describe using "`fl'", varlist
  5.     local vl `r(varlist)'
  6.     local has70 : list posof "hc70" in vl
  7.     local has72 : list posof "hc72" in vl
  8.     local has1  : list posof "hc1" in vl
  9.     if `has70' == 0 | `has72' == 0 | `has1' == 0 {
 10.         display as text "  PDHS `rd': no height and weight z-scores in the household member file"
 11.         continue
 12.     }
 13.     use hv005 hv024 hv103 hv104 hc1 hc70 hc72 using "`fl'", clear
 14.     * The recode carries hc1, hc70 and hc72 even when children were not
.     * measured (PDHS 2006-07), so test for values, not only for the names.
.     quietly count if !missing(hc1) & hc70 < 9990
 15.     if r(N) == 0 {
 16.         display as text "  PDHS `rd': height and weight z-scores are empty in the household member file"
 17.         continue
 18.     }
 19.     nhdr_pdhs_region hv024, generate(prov)
 20.     drop if inlist(prov, "Gilgit-Baltistan", "AJK", "")
 21.     keep if hv103 == 1 & hc1 < 60 & !missing(hc1)
 22.     gen double stunted = (hc70 < -200) if hc70 < 9990
 23.     gen double wasted  = (hc72 < -200) if hc72 < 9990
 24.     gen str6 sex = cond(hv104 == 1, "Male", cond(hv104 == 2, "Female", ""))
 25.     gen double wt = hv005 / 1000000
 26.     tempfile pdPR
 27.     save `pdPR'
 28.     * Pakistan and provinces, both sexes and by sex.
.     collapse (mean) stunted wasted [aw=wt]
 29.     gen str20 domain = "Pakistan"
