. * ---- 13.3 Decomposition of the change, final and survey basis ----------------------------
. foreach b in final survey {
  2.     if "`b'" == "final"  local p ""
  3.     if "`b'" == "survey" local p "sb_"
  4.     gen double `b'_education_pct = 100 * (ln(`p'education_index) - ln(edu_idx_2018_19)) / 3
  5.     gen double `b'_health_pct    = 100 * (ln(`p'health_index)    - ln(health_idx_2018_19)) / 3
  6.     gen double `b'_income_pct    = 100 * (ln(`p'income_index)    - ln(income_idx_2018_19)) / 3
  7.     gen double `b'_total_pct     = `b'_education_pct + `b'_health_pct + `b'_income_pct
  8. }

