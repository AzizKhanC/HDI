. *==============================================================================*
. * SECTION 1   HELPER PROGRAMS
. *==============================================================================*
. * Fifteen small programs carry the arithmetic that is used more than once. They
. * are defined here so that each step below reads as a statement of method
. * rather than as a block of code.
. 
. * ---- 1.1 nhdr_check: record one validation check ------------------------------
. * label : what is being checked
. * got   : the value this do file computed
. * want  : the target, a published figure or the reference result
. * tol   : the largest absolute difference accepted as a match
. capture program drop nhdr_check

. program define nhdr_check
  1.     syntax , LABel(string) GOT(string) WANT(real) TOL(real)
  2.     local g = `got'
  3.     local d = abs(`g' - `want')
  4.     global NCHK = $NCHK + 1
  5.     if `d' <= `tol' local status "PASS"
  6.     else {
  7.         local status "FAIL"
  8.         global NFAIL = $NFAIL + 1
  9.     }
 10.     display as text "`status'  " as result %-66s `"`label'"' ///
>         as text "  computed " as result %12.4f `g' ///
>         as text "  target " as result %12.4f `want' ///
>         as text "  tol " as result %7.4f `tol'
 11.     file write chk "`status'" _tab `"`label'"' _tab %14.6f (`g') _tab ///
>         %14.6f (`want') _tab %9.4f (`tol') _n
 12.     if "`status'" == "FAIL" & $STRICT == 1 {
 13.         display as error "A check failed and STRICT is 1. Stopping."
 14.         exit 9
 15.     }
 16. end

. 
. * ---- 1.2 nhdr_stack_domains: put each record in its reporting domains -------
. * Every person or household belongs to four of the 15 NHDR domains: Pakistan,
. * Pakistan urban or rural, its province, and its province urban or rural.
. * The program makes four copies of each record and labels each copy with one
. * domain, so that a single collapse by domain produces all 15 rows at once.
. * Domain labels match the region column of the published tables exactly,
. * for example "Khyber Pakhtunkhwa-Rural".
. capture program drop nhdr_stack_domains

. program define nhdr_stack_domains
  1.     syntax , PROVince(varname) REGion(varname)
  2.     tempvar pid copy pname rname
  3.     gen long `pid' = _n
  4.     expand 4
  5.     bysort `pid': gen byte `copy' = _n
  6.     gen str18 `pname' = ""
  7.     replace `pname' = "Khyber Pakhtunkhwa" if `province' == 1
  8.     replace `pname' = "Punjab"             if `province' == 2
  9.     replace `pname' = "Sindh"              if `province' == 3
 10.     replace `pname' = "Balochistan"        if `province' == 4
 11.     gen str5 `rname' = ""
 12.     replace `rname' = "Rural" if `region' == 1
 13.     replace `rname' = "Urban" if `region' == 2
 14.     gen str30 domain = ""
 15.     replace domain = "Pakistan"                  if `copy' == 1
 16.     replace domain = "Pakistan-" + `rname'       if `copy' == 2 & `rname' != ""
 17.     replace domain = `pname'                     if `copy' == 3
 18.     replace domain = `pname' + "-" + `rname'     if `copy' == 4 & `pname' != "" & `rname' != ""
 19.     * A record with a missing province or region stays in the domains it
.     * can be placed in and is dropped from the others.
.     drop if domain == ""
 20. end

. 
. * ---- 1.3 nhdr_quintile: equal-population quintiles within a group -----------
. * Records are sorted on per capita welfare within each group, the weight is
. * cumulated, and quintile = ceil(5 x cumulative share of the weight), kept
. * between 1 and 5. Records with missing welfare or weight get no quintile.
. * The cut is over everyone in the group, not only over the population in an
. * indicator's own universe. Poorer households hold more children, so the
. * 15-and-over population is not spread 20 percent per quintile, and the
. * published quintile rows do not average to the published total. Cutting over
. * all persons reproduces that behaviour.
. capture program drop nhdr_quintile

. program define nhdr_quintile
  1.     syntax , WELfare(varname) WTvar(varname) BY(varname) GENerate(name)
  2.     tempvar ok w0 cum tot
  3.     gen byte `ok' = !missing(`welfare', `wtvar')
  4.     gen double `w0' = cond(`ok', `wtvar', 0)
  5.     * Missing welfare sorts last, so it never enters the running sum.
.     bysort `by' (`welfare'): gen double `cum' = sum(`w0')
  6.     by `by': egen double `tot' = total(`w0')
  7.     gen byte `generate' = ceil((`cum' / `tot') * 5) if `ok'
  8.     replace `generate' = 1 if `generate' < 1 & `ok'
  9.     replace `generate' = 5 if `generate' > 5 & `ok' & !missing(`generate')
 10. end

. 
. * ---- 1.4 nhdr_index: the NHDR 2020 Human Development Index (HDI) construction ------------------------------
. * Recovered by inversion from Table 1 in Section 5 and verified there against
. * all 120 published dimension indices and composites.
. *   education  E = (2/3)(literacy/100) + (1/3)(net enrolment/100)
. *              the pre-2010 UNDP education index
. *   health     H = (LE - 25) / (90 - 25)
. *              a 65-year band, neither the pre-2010 25 to 85 nor the
. *              post-2010 20 to 85
. *   income     I = (ln PCI - ln 100) / (ln 100,000 - ln 100)
. *              PPP international dollars, a band no UNDP vintage uses
. *   composite  HDI = (E x H x I)^(1/3), the post-2010 geometric mean
. * Classification thresholds are those of the NHDR 2020 Readers' guide.
. capture program drop nhdr_index

. program define nhdr_index
  1.     syntax , LITeracy(varname) ENRolment(varname) LIFE(varname) INCome(varname) ///
>         [PREfix(string)]
  2.     gen double `prefix'education_index = (2/3) * (`literacy' / 100) + (1/3) * (`enrolment' / 100)
  3.     gen double `prefix'health_index    = (`life' - 25) / (90 - 25)
  4.     gen double `prefix'income_index    = (ln(`income') - ln(100)) / (ln(100000) - ln(100))
  5.     gen double `prefix'hdi = (`prefix'education_index * `prefix'health_index * ///
>         `prefix'income_index)^(1/3)
  6.     gen str24 `prefix'classification = ""
  7.     replace `prefix'classification = "High human development"   if `prefix'hdi >= 0.700 & !missing(`prefix'hdi)
  8.     replace `prefix'classification = "Medium human development" if `prefix'hdi >= 0.550 & `prefix'hdi < 0.700
  9.     replace `prefix'classification = "Low human development"    if `prefix'hdi <  0.550
 10. end

. 
. * ---- 1.5 nhdr_le_from_q5: life expectancy implied by under-five mortality ---
. * Model life table families carry, for each mortality level, the probability
. * of dying before age five (q5) and life expectancy at birth (e0). Levels 13
. * to 24 bracket Pakistan: e0 from 50.0 to 77.5 years. Life expectancy is read
. * off by linear interpolation of e0 on ln(q5), because q5 falls geometrically
. * across levels, and a linear reading would drift at the low-mortality end
. * where Pakistan's better districts sit. Outside the tabulated range the end
. * level is used. The family parameters are loaded in Section 2.4.
. capture program drop nhdr_le_from_q5

. program define nhdr_le_from_q5
  1.     syntax varname(numeric), GENerate(name) [FAMily(string)]
  2.     if "`family'" == "" local family "west"
  3.     local q5list ${MLT_`family'_q5}
  4.     local e0list ${MLT_`family'_e0}
  5.     local n : word count `q5list'
  6.     local q1 : word 1 of `q5list'
  7.     local e1 : word 1 of `e0list'
  8.     local qn : word `n' of `q5list'
  9.     local en : word `n' of `e0list'
 10.     tempvar lq
 11.     gen double `lq' = ln(`varlist' / 1000) if `varlist' > 0
 12.     gen double `generate' = .
 13.     * Mortality above the highest tabulated level: the level 13 value.
.     replace `generate' = `e1' if `lq' >= ln(`q1') & !missing(`lq')
 14.     * Mortality below the lowest tabulated level, including zero: level 24.
.     replace `generate' = `en' if (`lq' <= ln(`qn')) | (`varlist' == 0)
 15.     forvalues k = 1/`=`n'-1' {
 16.         local qa : word `k' of `q5list'
 17.         local qb : word `=`k'+1' of `q5list'
 18.         local ea : word `k' of `e0list'
 19.         local eb : word `=`k'+1' of `e0list'
 20.         replace `generate' = `ea' + (`eb' - `ea') * (`lq' - ln(`qa')) / (ln(`qb') - ln(`qa')) ///
>             if `lq' <= ln(`qa') & `lq' > ln(`qb') & !missing(`lq')
 21.     }
 22. end

. 
. * ---- 1.6 nhdr_q5_from_le: the inverse, used to audit a life expectancy ------
. * Interpolates ln(q5) on e0 within the family and returns q5 per 1,000.
. capture program drop nhdr_q5_from_le

. program define nhdr_q5_from_le
  1.     syntax varname(numeric), GENerate(name) [FAMily(string)]
  2.     if "`family'" == "" local family "west"
  3.     local q5list ${MLT_`family'_q5}
  4.     local e0list ${MLT_`family'_e0}
  5.     local n : word count `q5list'
  6.     local q1 : word 1 of `q5list'
  7.     local e1 : word 1 of `e0list'
  8.     local qn : word `n' of `q5list'
  9.     local en : word `n' of `e0list'
 10.     tempvar lq
 11.     gen double `lq' = .
 12.     replace `lq' = ln(`q1') if `varlist' <= `e1'
 13.     replace `lq' = ln(`qn') if `varlist' >= `en' & !missing(`varlist')
 14.     forvalues k = 1/`=`n'-1' {
 15.         local qa : word `k' of `q5list'
 16.         local qb : word `=`k'+1' of `q5list'
 17.         local ea : word `k' of `e0list'
 18.         local eb : word `=`k'+1' of `e0list'
 19.         replace `lq' = ln(`qa') + (ln(`qb') - ln(`qa')) * (`varlist' - `ea') / (`eb' - `ea') ///
>             if `varlist' >= `ea' & `varlist' < `eb'
 20.     }
 21.     gen double `generate' = exp(`lq') * 1000
 22. end

. 
. * ---- 1.7 nhdr_q5: synthetic cohort under-five mortality ---------------------
. * The DHS and MICS method (Rutstein and Rojas 2006, chapter 8). Births in the
. * window before interview are split into eight age segments, in months:
. * 0-1, 1-3, 3-6, 6-12, 12-24, 24-36, 36-48, 48-60. For each segment j
. *    E_j = weighted births that survived to the start of the segment and whose
. *          time since birth covers the whole segment (the exposed)
. *    D_j = weighted deaths among the exposed at an age inside the segment
. * and the segment probabilities are chained:
. *    q5 = 1000 x (1 - prod_j (1 - D_j / E_j))
. * The synthetic cohort refers to the middle of the window rather than to
. * children born five years or more before the survey, which is what makes it
. * comparable across provinces surveyed in different years.
. * Expects, in memory, the MICS6 birth history fields
. *    bh4c     date of birth, century month code
. *    wdoi     date of interview, century month code
. *    bh5      child alive: 1 yes, 2 no
. *    bh9c     age at death in months, imputed
. *    wmweight women's sample weight
. * and replaces the data in memory with one row per group, holding
. * u5mr_per_1000, births (unweighted, in the window) and deaths_weighted.
. capture program drop nhdr_q5

. program define nhdr_q5
  1.     syntax , BY(varlist) WINDOW(integer)
  2.     tempvar mb died agedth one dth5
  3.     gen double `mb' = wdoi - bh4c                     // months since birth
  4.     keep if inrange(`mb', 0, 12 * `window') & !missing(wmweight) & !missing(bh4c)
  5.     gen byte `died' = (bh5 == 2)
  6.     gen double `agedth' = bh9c if `died'              // age at death, dead only
  7.     local elist
  8.     local dlist
  9.     local j = 0
 10.     foreach seg in "0 1" "1 3" "3 6" "6 12" "12 24" "24 36" "36 48" "48 60" {
 11.         local ++j
 12.         local lo : word 1 of `seg'
 13.         local hi : word 2 of `seg'
 14.         * Reached the segment: alive, or died at age lo or later. A death with
.         * no recorded age stays in the exposed and is never counted as a death,
.         * which is the conservative treatment and the one the Python package
.         * used.
.         gen double _e`j' = wmweight * ((missing(`agedth') | `agedth' >= `lo') & `mb' >= `hi')
 15.         gen double _d`j' = wmweight * ((missing(`agedth') | `agedth' >= `lo') & `mb' >= `hi' ///
>             & `agedth' >= `lo' & `agedth' < `hi')
 16.         local elist `elist' _e`j'
 17.         local dlist `dlist' _d`j'
 18.     }
 19.     gen double `dth5' = wmweight * (`agedth' < 60)
 20.     gen byte `one' = 1
 21.     collapse (sum) `elist' `dlist' deaths_weighted=`dth5' (count) births=`one', by(`by')
 22.     gen double _surv = 1
 23.     forvalues j = 1/8 {
 24.         replace _surv = _surv * (1 - _d`j' / _e`j') if _e`j' > 0
 25.     }
 26.     gen double u5mr_per_1000 = (1 - _surv) * 1000
 27.     gen int window_years = `window'
 28.     drop `elist' `dlist' _surv
 29. end

. 
. * ---- 1.8 nhdr_district_key: a matching key for district names --------------
. * PSLM and MICS6 spell the same district in up to four ways. The key is the
. * name in lower case, with anything other than a to z or a space turned into
. * a space and runs of spaces collapsed. An explicit alias list then maps the
. * remaining spellings onto one key. The list is written out rather than left
. * to a fuzzy matcher, which would pair Kohat with Kohlu.
. capture program drop nhdr_district_key

. program define nhdr_district_key
  1.     syntax varname(string), GENerate(name)
  2.     tempvar raw
  3.     gen str60 `raw' = lower(`varlist')
  4.     replace `raw' = ustrregexra(`raw', "[^a-z ]", " ")
  5.     replace `raw' = stritrim(strtrim(`raw'))
  6.     gen str60 `generate' = `raw'
  7.     local pairs `" "d i khan" "dera ismail khan" "d g khan" "dg khan" "bajur" "bajor" "bunair" "buner" "charsada" "charsadda" "batagram" "batagram" "tor ga
> rh" "torghar" "abbottabad" "abbotabad" "haripur" "hari pur" "hari pur" "hari pur" "kurram" "kuram" "lakki marwat" "laki marwat" "mohmand" "mohmind" "nowshera"
>  "nowshehra" "jehlum" "jhelum" "bhakhar" "bhakkar" "t t singh" "tt singh" "muzaffar garh" "muzaffargarh" "rahim yar khan" "ry khan" "shahdadkot" "shahdad kot"
>  "umer kot" "umer kot" "mir pur khas" "mirpurk khas" "nowshero feroze" "naushahro feroze" "shaheed banazir abad" "shaheed benazirabad" "tando allah yar" "tand
> o allahyar" "tando muhammad khan" "tando muhmmad khan" "kachhi bolan" "kachhi bolan" "kech turbat" "kech turbat" "nasirabad tamboo" "nasirabad" "musa khel" "m
> usakhel" "qilla abdullah" "killa abdullah" "qilla saifullah" "killa saifullah" "shaheed sikandar abad" "shaheed sikandarabad" "sherani" "sheerani" "chagai" "c
> haghi" "panjgoor" "panjgur" "sibbi" "sibbi" "karachi malir" "karachi malir" "korangi" "karachi korangi" "'
  8.     local n : word count `pairs'
  9.     forvalues k = 1(2)`n' {
 10.         local from : word `k' of `pairs'
 11.         local to   : word `=`k'+1' of `pairs'
 12.         * Matched on the normalized name before any alias is applied, so an
.         * alias is applied once and never chained.
.         replace `generate' = "`to'" if `raw' == "`from'"
 13.     }
 14. end

. 
. * ---- 1.9 nhdr_prov_long: one row of provincial values to long form ----------
. * Published allocator tables arrive with one column per province. This turns
. * the four provincial columns of a single row into four rows of code,
. * province and value, the shape the allocation in Section 9 needs.
. capture program drop nhdr_prov_long

. program define nhdr_prov_long
  1.     syntax , CODE(string)
  2.     keep punjab sindh khyberpakhtunkhwa balochistan
  3.     gen byte _row = 1
  4.     rename (punjab sindh khyberpakhtunkhwa balochistan) (v1 v2 v3 v4)
  5.     reshape long v, i(_row) j(_p)
  6.     gen str20 province = ""
  7.     replace province = "Punjab"             if _p == 1
  8.     replace province = "Sindh"              if _p == 2
  9.     replace province = "Khyber Pakhtunkhwa" if _p == 3
 10.     replace province = "Balochistan"        if _p == 4
 11.     gen str8 code = "`code'"
 12.     rename v value
 13.     keep code province value
 14. end

. 
. * ---- 1.10 nhdr_atkinson: inequality across groups, Atkinson with aversion 1 ---
. * For each variable, within each group of the by() variable:
. *     A = 1 - exp(mean(ln x)) / mean(x)
. * one minus the ratio of the geometric to the arithmetic mean. Used over the
. * five equal-population quintiles, so the unweighted means are exact.
. * Creates <prefix><variable> on every row of the group.
. capture program drop nhdr_atkinson

. program define nhdr_atkinson
  1.     syntax varlist(numeric), BY(varlist) PREfix(string)
  2.     foreach v of local varlist {
  3.         tempvar lv am gm
  4.         gen double `lv' = ln(`v')
  5.         bysort `by': egen double `am' = mean(`v')
  6.         by `by': egen double `gm' = mean(`lv')
  7.         gen double `prefix'`v' = 1 - exp(`gm') / `am'
  8.         drop `lv' `am' `gm'
  9.     }
 10. end

. 
. * ---- 1.11 nhdr_gdi_hdi: HDI for one sex, Gender Development Index (GDI) ----
. * As nhdr_index, except that the income index runs from 100 to 75,000 PPP
. * dollars, the goalposts Table 6 is printed on (Section 17.1).
. capture program drop nhdr_gdi_hdi

. program define nhdr_gdi_hdi
  1.     syntax , LITeracy(varname) ENRolment(varname) LIFE(varname) INCome(varname) [PREfix(string)]
  2.     if "`prefix'" == "" local prefix "gdi_"
  3.     gen double `prefix'edu = (2/3) * (`literacy' / 100) + (1/3) * (`enrolment' / 100)
  4.     gen double `prefix'hea = (`life' - 25) / (90 - 25)
  5.     gen double `prefix'inc = (ln(`income') - ln(100)) / (ln(75000) - ln(100))
  6.     gen double `prefix'hdi = (`prefix'edu * `prefix'hea * `prefix'inc)^(1/3)
  7. end

. 
. * ---- 1.12 nhdr_gii: the Gender Inequality Index (GII), NHDR 2020 variant ---------
. * Inputs in percent. See Section 18 for the formula and its recovery.
. capture program drop nhdr_gii

. program define nhdr_gii
  1.     syntax , NOCare(varname) EVMarried(varname) SEATF(varname) SEATM(varname) ///
>         SECF(varname) SECM(varname) LFPRF(varname) LFPRM(varname) [PREfix(string)]
  2.     if "`prefix'" == "" local prefix "gii_"
  3.     gen double `prefix'health_f   = sqrt(1 / (`nocare' * `evmarried'))
  4.     gen double `prefix'emp_f      = sqrt((`seatf' / 100) * (`secf' / 100))
  5.     gen double `prefix'emp_m      = sqrt((`seatm' / 100) * (`secm' / 100))
  6.     gen double `prefix'g_f        = (`prefix'health_f * `prefix'emp_f * (`lfprf' / 100))^(1/3)
  7.     gen double `prefix'g_m        = (1 * `prefix'emp_m * (`lfprm' / 100))^(1/3)
  8.     gen double `prefix'harm       = 1 / ((1 / `prefix'g_f + 1 / `prefix'g_m) / 2)
  9.     gen double `prefix'health_bar = (`prefix'health_f + 1) / 2
 10.     gen double `prefix'emp_bar    = (`prefix'emp_f + `prefix'emp_m) / 2
 11.     gen double `prefix'lfpr_bar   = ((`lfprf' + `lfprm') / 100) / 2
 12.     gen double `prefix'g_fm       = (`prefix'health_bar * `prefix'emp_bar * `prefix'lfpr_bar)^(1/3)
 13.     gen double `prefix'gii        = 1 - `prefix'harm / `prefix'g_fm
 14. end

. 
. * ---- 1.13 nhdr_by_province: weighted means for Pakistan and the provinces ---
. * Replaces the data in memory with five rows (Pakistan and the four
. * provinces), each holding the weighted mean of every listed variable over
. * its own non-missing universe.
. capture program drop nhdr_by_province

. program define nhdr_by_province
  1.     syntax , VARs(varlist) WGT(varname) PROVince(varname)
  2.     drop if missing(`wgt')
  3.     tempfile base prov
  4.     save `base'
  5.     collapse (mean) `vars' [aw=`wgt'], by(`province')
  6.     gen str20 domain = ""
  7.     replace domain = "Khyber Pakhtunkhwa" if `province' == 1
  8.     replace domain = "Punjab"             if `province' == 2
  9.     replace domain = "Sindh"              if `province' == 3
 10.     replace domain = "Balochistan"        if `province' == 4
 11.     drop if domain == ""
 12.     drop `province'
 13.     save `prov'
 14.     use `base', clear
 15.     collapse (mean) `vars' [aw=`wgt']
 16.     gen str20 domain = "Pakistan"
 17.     append using `prov'
 18. end

. 
. * ---- 1.14 nhdr_earned_income: the female share of earned income ------------
. * The UNDP split (HDR 2019 Technical Note 3):
. *     S_f = (W_f/W_m x EA_f) / (W_f/W_m x EA_f + EA_m)
. * EA_f  female share of the economically active population aged 10 and over
. * W_f/W_m  ratio of mean female to mean male annual earnings, paid employees
. * Replaces the data in memory with one row per domain (Pakistan and the
. * provinces) holding ea_f, wage_ratio and s_f.
. capture program drop nhdr_earned_income

. program define nhdr_earned_income
  1.     syntax , SEX(varname) ACTive(varname) EARN(varname) AGE(varname) WGT(varname) DOMain(name)
  2.     keep if `age' >= 10 & !missing(`age') & !missing(`wgt')
  3.     gen double _af = `wgt' * (`active' == 1) * (`sex' == 2)
  4.     gen double _am = `wgt' * (`active' == 1) * (`sex' == 1)
  5.     gen double _xf = cond(!missing(`earn') & `sex' == 2, `wgt' * `earn', 0)
  6.     gen double _xm = cond(!missing(`earn') & `sex' == 1, `wgt' * `earn', 0)
  7.     gen double _nf = cond(!missing(`earn') & `sex' == 2, `wgt', 0)
  8.     gen double _nm = cond(!missing(`earn') & `sex' == 1, `wgt', 0)
  9.     tempfile ind prov
 10.     save `ind'
 11.     collapse (sum) _af _am _xf _xm _nf _nm, by(`domain')
 12.     save `prov'
 13.     use `ind', clear
 14.     collapse (sum) _af _am _xf _xm _nf _nm
 15.     gen str20 `domain' = "Pakistan"
 16.     append using `prov'
 17.     drop if `domain' == ""
 18.     gen double ea_f       = _af / (_af + _am)
 19.     gen double wage_ratio = (_xf / _nf) / (_xm / _nm)
 20.     gen double s_f        = wage_ratio * ea_f / (wage_ratio * ea_f + (1 - ea_f))
 21.     keep `domain' ea_f wage_ratio s_f
 22. end

. 
. * ---- 1.15 nhdr_fig_done: count a figure and confirm its file was written ----
. capture program drop nhdr_fig_done

. program define nhdr_fig_done
  1.     args file
  2.     global NFIG = $NFIG + 1
  3.     capture confirm file "`file'"
  4.     if _rc display as error "Figure not written: `file'"
  5.     else global NFIGOK = $NFIGOK + 1
  6. end

