  5.     gen double yrs = cond(missing(edu) | edu <= 1, 0, cond(edu <= 5, 8, cond(edu == 6, 10, ///
>         cond(edu == 7, 12, 17))))
  6.     gen double hc   = yrs if act == 1
  7.     gen double e    = emp
  8.     gen double wage_e = wage if emp == 1 & employee == 1 & wage > 0 & !missing(wage)
  9.     gen double wtop = wage_e if inlist(occ1, 1, 2)
 10.     gen double wbot = wage_e if inlist(occ1, 8, 9)
 11.     gen double wf   = wage_e if sex == 2
 12.     gen double wm   = wage_e if sex == 1
 13.     gen double mwok = (wage_e > mw) if !missing(wage_e)
 14.     gen double dh   = (hours > 10 & hours < 48) if emp == 1 & hours > 0 & !missing(hours)
 15.     gen double fe   = formal if emp == 1
 16.     gen double cf   = cfw if emp == 1
 17.     gen double n_ee  = ws * (emp == 1 & employee == 1)
 18.     gen double n_se  = ws * (emp == 1 & selfemp == 1)
 19.     gen double n_emp = ws * (emp == 1)
 20.     nhdr_lfs_domains, province(prov) sex(sex)
 21.     collapse (mean) epr=e humcap=hc wbar=wage_e wtop wbot wf wm mwok dh fe cf ///
>         (rawsum) n_ee n_se n_emp [aw=w], by(region)
 22.     gen double skillprem = wtop / wbot
 23.     * Wage ratio: each province its own, and the two sexes take the national one.
.     gen double wr = wf / wm
 24.     quietly summarize wr if region == "Pakistan"
 25.     replace wr = r(mean) if inlist(region, "Pakistan - Male", "Pakistan - Female")
 26.     gen double decentwork = exp((ln(100 * mwok) + ln(100 * dh) + ln(100 * fe) + ln(100 - 100 * cf) + ln(wr)) / 5)
 27.     gen double LI = 12 * wbar * (n_ee + 0.8 * n_se)
 28.     merge 1:1 region using `grpsh', keepusing(sh_`fy') nogenerate
 29.     quietly summarize n_emp if region == "Pakistan"
 30.     local nemp = r(mean)
 31.     gen double G = gdp_`fy'
 32.     replace G = gdp_`fy' * sh_`fy' if !missing(sh_`fy')
 33.     replace G = gdp_`fy' * n_emp / `nemp' if inlist(region, "Pakistan - Male", "Pakistan - Female")
 34.     gen double lshare = LI / (LI + 0.7 * (G - LI))
 35.     gen str7 year = subinstr("`fy'", "_", "-", .)
