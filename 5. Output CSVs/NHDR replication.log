. * ---- 0.4 Confirm that every raw file is where the do file expects it --------
. * The PDHS rounds arrive from the DHS Program as one zip per round. If a
. * round's folder does not exist yet but its zip does, the zip is unpacked
. * in place with the official unzipfile command. The folders it creates
. * (PKBR71DT and so on) are the ones the paths above point to.
. foreach b in "PK_2006-07_DHS_09292026_925_170967" "PK_2012-13_DHS_09292026_924_170967" ///
>     "PK_2017-18_DHS_09292026_924_170967" {
  2.     local probe = cond(strpos("`b'", "2006-07"), "PKBR53DT/PKBR53FL.DTA", ///
>         cond(strpos("`b'", "2012-13"), "PKBR61DT/PKBR61FL.DTA", "PKBR71DT/PKBR71FL.DTA"))
  3.     capture confirm file "$pdhs/`b'/`probe'"
  4.     if _rc {
  5.         capture confirm file "$pdhs/`b'.zip"
  6.         if !_rc {
  7.             local here `"`c(pwd)'"'
  8.             capture mkdir "$pdhs/`b'"
  9.             quietly cd "$pdhs/`b'"
 10.             capture noisily unzipfile "$pdhs/`b'.zip", replace
 11.             quietly cd `"`here'"'
 12.         }
 13.     }
 14. }

