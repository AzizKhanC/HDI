. * ---- 27.2 The results workbook ---------------------------------------------------------
. * One worksheet per results table, in the order of "Output descriptions.csv"
. * (folder 1. Dos). Row 1 of each sheet is its headline, row 2 names the CSV it
. * comes from, and the table starts on row 4 with the descriptive column names
. * of "Variable dictionary.csv". The CSV files keep the short variable names.
. local xlsx "$out/NHDR replication results.xlsx"

. local runname = substr("$out", strrpos("$out", "/") + 1, .)

. capture frame drop vdict

. frame create vdict

. frame vdict: import delimited using "$root/1. Dos/Variable dictionary.csv", clear ///
>     varnames(1) encoding(utf-8) stringcols(_all) bindquote(strict)
(3 vars, 1,033 obs)

. import delimited using "$root/1. Dos/Output descriptions.csv", clear varnames(1) ///
>     encoding(utf-8) stringcols(_all) bindquote(strict)
(3 vars, 61 obs)

. local nsheet = _N

. forvalues k = 1/`nsheet' {
  2.     local f`k' = file[`k']
  3.     local s`k' = sheet[`k']
  4.     local h`k' = headline[`k']
  5. }

. local first = 1

. forvalues k = 1/`nsheet' {
  2.     capture confirm file "$out/`f`k''.csv"
  3.     if _rc {
  4.         display as error "Workbook: `f`k''.csv not found, its sheet is skipped"
  5.         continue
  6.     }
  7.     import delimited using "$out/`f`k''.csv", clear varnames(1) asdouble encoding(utf-8) case(preserve)
  8.     foreach v of varlist _all {
  9.         frame vdict: quietly levelsof label if file == "`f`k''" & lower(variable) == lower("`v'"), ///
>             local(lab) clean
 10.         if `"`lab'"' != "" label variable `v' `"`lab'"'
 11.     }
 12.     local opt = cond(`first', "replace", "sheetreplace")
 13.     export excel using "`xlsx'", sheet("`s`k''") `opt' cell(A4) firstrow(varlabels)
 14.     putexcel set "`xlsx'", sheet("`s`k''") modify
 15.     putexcel A1 = `"`h`k''"', bold
 16.     putexcel A2 = `"Source: 8. Stata runs/`runname'/`f`k''.csv"', italic
 17.     putexcel clear
 18.     local first = 0
 19. }
