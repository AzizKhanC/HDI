. * ---- 26A.3 The HDI, its quintiles and the IHDI, four years -----------------------------
. tempfile hser

. local first = 1

. foreach spec in "2006-07|s05|2006_07" "2012-13|s11|2012_13" "2015-16|s15|2015_16" "2018-19|s18|2018_19" {
  2.     tokenize "`spec'", parse("|")
  3.     local yr `1'
  4.     local pf `3'
  5.     local g `5'
  6.     use ``pf'', clear
  7.     gen str8 domain = "Pakistan"
  8.     nhdr_quintile, welfare(pc_exp) wtvar(w) by(domain) generate(q)
  9.     tempfile pp a0
 10.     save `pp'
 11.     collapse (mean) lit15 ner cons=pc_exp [aw=w]
 12.     gen str3 quintile = "All"
 13.     save `a0'
 14.     use `pp', clear
 15.     drop if missing(q)
 16.     collapse (mean) lit15 ner cons=pc_exp [aw=w], by(q)
 17.     gen str3 quintile = "Q" + string(q)
 18.     drop q
 19.     append using `a0'
 20.     replace lit15 = 100 * lit15
 21.     replace ner   = 100 * ner
 22.     quietly summarize cons if quintile == "All"
 23.     gen double pci = cons * gnify_`g' / r(mean)
 24.     gen str7 year = "`yr'"
 25.     merge 1:1 year quintile using `mort', keep(master match) nogenerate
 26.     if `first' == 0 append using `hser'
 27.     save `hser', replace
 28.     local first = 0
 29. }
